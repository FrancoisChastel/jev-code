# One key is required. The key's prefix picks the host, whichever variable holds it.
# TypeSafe direct: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# Vercel AI Gateway: https://vercel.com/docs/ai-gateway/authentication-and-byok/api-keys
# AI_GATEWAY_API_KEY=

# Optional overrides (defaults shown)
# JEV_CODE_PROVIDER=typesafe            # typesafe | openrouter | vercel; forces the host when several keys are set
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest     # typesafe-ai/jev on Vercel AI Gateway
# JEV_CODE_TIMEOUT_MS=30000
# JEV_CODE_MAX_RETRIES=2
