# One key is required, in its host's variable. The variable decides the host, not the key's shape.
# TypeSafe direct: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# Vercel AI Gateway: https://vercel.com/docs/ai-gateway/authentication-and-byok/api-keys
# AI_GATEWAY_API_KEY=
# OpenAI Decisions API (public beta); opt in with JEV_CODE_PROVIDER=openai
# OPENAI_API_KEY=
# Ollama (local, no key); opt in with JEV_CODE_PROVIDER=ollama after `ollama pull nimble`
# OLLAMA_HOST=localhost:11434

# Optional overrides (defaults shown)
# JEV_CODE_PROVIDER=typesafe            # typesafe | openrouter | vercel | openai | ollama; forces the host (required for the last two)
# TYPESAFE_BASE_URL=https://api.typesafe.ai   # a proxy or a System One gateway of your own; /v1/systemone is appended
# TYPESAFE_DEFAULT_MODEL=jev-latest     # typesafe-ai/jev on Vercel AI Gateway
# JEV_CODE_TIMEOUT_MS=30000
# JEV_CODE_MAX_RETRIES=2
