{
  "name": "@francoischastel/jev-code",
  "version": "0.1.0",
  "description": "Jev, TypeSafe's System One classifier, as a tool inside Claude Code, Codex, Pi, and OpenCode: typed classify, check, score, rank, and ask, plus one-command setup.",
  "type": "module",
  "license": "MIT",
  "author": "Fran\u00e7ois Chastel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoisChastel/jev-code.git"
  },
  "homepage": "https://github.com/FrancoisChastel/jev-code#readme",
  "bugs": "https://github.com/FrancoisChastel/jev-code/issues",
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "classifier",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "opencode",
    "pi-package",
    "agent-skills"
  ],
  "bin": {
    "jev-code": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "integrations",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./integrations/pi"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "JEV_CODE_E2E=1 vitest run tests/e2e",
    "check:skill": "node scripts/check-skill.mjs",
    "presmoke": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:skill && npm run test:coverage && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@opencode-ai/plugin": "^1.18.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
